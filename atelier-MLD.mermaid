graph TD

    OPERATOR["OPERATOR
        ---
        id (PK)
        email
        password
        last_login
        is_active
    "]

    ITEM["ITEM
        ---
        id (PK)
        operator_id (FK)
        title
        description
        created_at
    "]

    TAG["TAG
        ---
        id (PK)
        operator_id (FK)
        parent_tag_id (FK)
        name
        slug
        created_at
        updated_at
    "]

    COLLECTION["COLLECTION
        ---
        id (PK)
        operator_id (FK)
        name
    "]

    COLLECTION_ITEM["COLLECTION_ITEM
        ---
        collection_id (FK, PK)
        item_id (FK, PK)
    "]

    ITEM_TAG["ITEM_TAG
        ---
        item_id (FK, PK)
        tag_id (FK, PK)
    "]


    OPERATOR ---|"1,1"| ITEM
    ITEM ---|"0,N"| OPERATOR

    OPERATOR ---|"1,1"| TAG
    TAG ---|"0,N"| OPERATOR

    OPERATOR ---|"1,1"| COLLECTION
    COLLECTION ---|"0,N"| OPERATOR


    TAG ---|"0,1"| TAG
    TAG ---|"0,N"| TAG


    COLLECTION ---|"1,N"| COLLECTION_ITEM
    COLLECTION_ITEM ---|"1,N"| ITEM


    ITEM ---|"1,N"| ITEM_TAG
    ITEM_TAG ---|"1,N"| TAG
